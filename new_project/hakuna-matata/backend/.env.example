# Example `.env` for backend (do NOT commit real secrets)
# Copy this file to `.env` and replace placeholder values with real ones for local development.

# OpenAI API key (optional; only required if you use OpenAI features)
OPENAI_API_KEY=your_openai_api_key_here

# MongoDB connection string. For local development the default is a local MongoDB instance.
# Example for local MongoDB: mongodb://127.0.0.1:27017/hakuna-matata
MONGO_URI=mongodb://127.0.0.1:27017/hakuna-matata

# Server port
PORT=5000

# JWT secret used to sign tokens in development. Use a strong secret in production.
JWT_SECRET=your_jwt_secret_here

# Environment
NODE_ENV=development

# Notes:
# - Keep secrets out of source control. Use `.env` locally and environment variables in production.
# - If you use MongoDB Atlas in production, set the Atlas URI on the production host instead of committing it here.
